class Provider
  class <%= @integration_name %>Service < BaseService
    BASE_URL = ENV.fetch('<%= @integration_name.upcase %>_BASE_URL', '<%= provider_default_url %>')
  
  <%- PROVIDER_PUBLIC_METHODS.each do |method| -%>
    <%- exception_block = self.class.method_defined?("#{method}_exceptions_block".to_sym) ? send("#{method}_exceptions_block".to_sym) : nil -%>
    <%= render_partial "provider_methods/#{method}", { document: @openapi_document, searcher: send("#{method}_searcher"), payload_schema: payload_schema, exception_block: exception_block} %>
  <%- end -%>

    private

  <%- PROVIDER_PRIVATE_METHODS.each do |method| -%>
    <%- exception_block = self.class.method_defined?("#{method}_exceptions_block".to_sym) ? send("#{method}_exceptions_block".to_sym) : nil -%>
    <%= render_partial "provider_methods/#{method}", { document: @openapi_document, exception_block: exception_block, payload_method_source: method == :build_payout_payload ? payload_method_source : nil } %>
  <%- end -%>
  end
end
