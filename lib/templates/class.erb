<%- @openapi_document.paths.each do |key, node| -%>
<%- SUPPORTED_HTTP_METHODS.each do |http_method| -%>
  <%- operation_item = node.send(http_method) -%>
  <%- next if operation_item.nil? -%>

  # <%= http_method.to_s.upcase %> <%= key %>
