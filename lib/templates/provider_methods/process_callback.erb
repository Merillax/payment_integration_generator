def process_callback(payload)
<%- uri, path_item = searcher.search_result -%>
<%- if searcher.todo_option -%>
  # TODO: не удалось однозначно определить эндпоинт создания выплаты в спеке — настройте вручную
  raise NotImplementedError, "process_callback не реализован: эндпоинт не найден автоматически"
<%- else -%>
  verify_signature!(payload) # HMAC-SHA256 из X-NovaPay-Signature

  case payload['<%= searcher.status_field(SUPPORTED_HTTP_METHODS.map { |method| path_item.public_send(method) }.compact.first)[:name]  %>']
  when 'payout.completed' then approve_operation(payload['payout_id'])
  when 'payout.failed'    then reject_operation(payload['payout_id'], payload.dig('error', 'code'))
  else failure(:unprocessable_entity, 'unknown_event')
  end
<%- end -%>
end
