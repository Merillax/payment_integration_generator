def fetch_status(operation)
<%- uri, path_item = searcher.search_result -%>
<%- if searcher.todo_option -%>
  # TODO: не удалось однозначно определить эндпоинт создания выплаты в спеке — настройте вручную
  raise NotImplementedError, "fetch_status не реализован: эндпоинт не найден автоматически"
<%- else -%>
  response = client.get("#{BASE_URL}<%= uri.gsub(/\{.*?\}/, '#{operation.provider_operation_id}') %>")
  map_status(response.body['<%= searcher.status_field(path_item)&.[](:name) || "TODO: укажите имя поля" %>'])
<%- end -%>
end
